# Claude (brand analysis, planning, QA) - https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Gemini (background scenes) - https://aistudio.google.com/api-keys (needs billing enabled)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=2K

# Credit left on each account is entered in the web UI (click the amount in the top bar)
# or with: python cli.py budget --set claude=2.26 gemini=4.50

# Safety limits
MAX_IMAGES_PER_RUN=30
MAX_REVIEW_RETRIES=2
IMAGE_WORKERS=3
